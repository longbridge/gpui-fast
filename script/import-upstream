#!/usr/bin/env python3
"""Replays zed's commits to the upstream directories onto a vendor branch.

The first step of a sync (docs/upstream-sync.md, "Syncing with upstream"):
starting at the `import_commit` recorded in `UPSTREAM`, every commit of zed
between `zed_commit` and the new commit that touches a directory listed under
`tracked` is applied again, limited to those directories, keeping its author,
committer, dates and message, with an `Upstream-commit:` trailer naming the
original. The vendor branch thus holds nothing but upstream's code, one commit
per zed commit, and the merge into our branch brings their history along.

A directory listed under `tracked` that the import commit doesn't have yet (a
crate newly taken from zed) is first imported whole, as zed had it at
`zed_commit`, in a commit of its own.

At the end each tracked directory must be identical to zed's at the new
commit; the script fails otherwise.

    script/import-upstream --zed ~/github/zed [--worktree DIR] [NEW]

NEW defaults to the zed checkout's `origin/main`. The branch is
`upstream/zed-<short NEW>`, checked out in a new worktree (default:
`../gpui-fast-upstream-<short NEW>`).
"""

import argparse
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UPSTREAM_FILE = os.path.join(ROOT, "UPSTREAM")
ZED_REPOSITORY = "zed-industries/zed"


def git(args, cwd=ROOT, input=None, env=None):
    result = subprocess.run(
        ["git", *args],
        cwd=cwd,
        input=input,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        check=False,
    )
    if result.returncode != 0:
        sys.exit(f"git {' '.join(args)} failed:\n{result.stderr.decode(errors='replace')}")
    return result.stdout


def git_text(args, cwd=ROOT):
    return git(args, cwd=cwd).decode().strip()


def read_upstream_config():
    """Reads the few keys `UPSTREAM` holds, without needing a TOML parser."""
    with open(UPSTREAM_FILE, encoding="utf-8") as file:
        text = re.sub(r"#.*", "", file.read())
    config = dict(re.findall(r'^(\w+)\s*=\s*"([^"]*)"', text, re.M))
    tracked = re.search(r"^tracked\s*=\s*\[(.*?)\]", text, re.M | re.S)
    config["tracked"] = re.findall(r'"([^"]+)"', tracked.group(1)) if tracked else []
    for key in ["zed_commit", "import_commit"]:
        if key not in config:
            sys.exit(f"UPSTREAM has no {key}")
    return config


def tree_of(commit, path, cwd):
    """The tree id of `path` at `commit`, or None when it has none."""
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"{commit}:{path}"],
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.decode().strip() or None


def commit_env(zed, commit):
    fields = git_text(
        ["show", "-s", "--format=%an%x00%ae%x00%aD%x00%cn%x00%ce%x00%cD", commit], cwd=zed
    ).split("\0")
    env = dict(os.environ)
    for key, value in zip(
        [
            "GIT_AUTHOR_NAME",
            "GIT_AUTHOR_EMAIL",
            "GIT_AUTHOR_DATE",
            "GIT_COMMITTER_NAME",
            "GIT_COMMITTER_EMAIL",
            "GIT_COMMITTER_DATE",
        ],
        fields,
    ):
        env[key] = value
    return env


def import_whole(zed, worktree, commit, path):
    """Copies zed's `path` at `commit` into the worktree and stages it."""
    archive = git(["archive", "--format=tar", commit, path], cwd=zed)
    subprocess.run(["tar", "-x"], cwd=worktree, input=archive, check=True)
    git(["add", "-A", "--", path], cwd=worktree)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--zed", required=True, help="path to a zed checkout")
    parser.add_argument("--worktree", help="where to check out the vendor branch")
    parser.add_argument("new", nargs="?", default="origin/main", help="zed commit to import")
    args = parser.parse_args()

    zed = os.path.abspath(os.path.expanduser(args.zed))
    config = read_upstream_config()
    old = config["zed_commit"]
    base = config["import_commit"]
    tracked = config["tracked"]
    new = git_text(["rev-parse", "--verify", f"{args.new}^{{commit}}"], cwd=zed)
    short = new[:7]

    if subprocess.run(["git", "merge-base", "--is-ancestor", old, new], cwd=zed).returncode != 0:
        sys.exit(f"{old} is not an ancestor of {new}")
    commits = git_text(
        ["rev-list", "--reverse", "--first-parent", f"{old}..{new}", "--", *tracked], cwd=zed
    ).split()
    commits = [commit for commit in commits if commit]

    branch = f"upstream/zed-{short}"
    worktree = os.path.abspath(args.worktree or os.path.join(ROOT, "..", f"gpui-fast-upstream-{short}"))
    git(["worktree", "add", "-b", branch, worktree, base])
    print(f"{branch} at {worktree}, from {base[:7]}; {len(commits)} zed commits to replay")

    new_paths = [path for path in tracked if tree_of(base, path, worktree) is None]
    if new_paths:
        for path in new_paths:
            import_whole(zed, worktree, old, path)
        env = commit_env(zed, old)
        message = (
            f"zed: import {', '.join(new_paths)} at {old[:10]}\n\n"
            f"Upstream-commit: {ZED_REPOSITORY}@{old}\n"
        )
        git(["commit", "-q", "-m", message], cwd=worktree, env=env)
        print(f"imported {', '.join(new_paths)} at {old[:7]}")

    for index, commit in enumerate(commits, 1):
        parent = f"{commit}^"
        patch = git(["diff", "--binary", "--full-index", parent, commit, "--", *tracked], cwd=zed)
        if not patch:
            continue
        git(["apply", "--index", "--binary", "--whitespace=nowarn"], cwd=worktree, input=patch)
        message = git(["show", "-s", "--format=%B", commit], cwd=zed).decode().rstrip()
        message += f"\n\nUpstream-commit: {ZED_REPOSITORY}@{commit}\n"
        git(["commit", "-q", "--allow-empty", "-m", message], cwd=worktree, env=commit_env(zed, commit))
        subject = message.splitlines()[0]
        print(f"[{index}/{len(commits)}] {commit[:7]} {subject}")

    mismatched = [path for path in tracked if tree_of("HEAD", path, worktree) != tree_of(new, path, zed)]
    if mismatched:
        sys.exit(f"after the replay these differ from zed at {short}: {', '.join(mismatched)}")
    print(f"done: {branch} matches zed {short} in every tracked directory")
    print(f"vendor commit (the new import_commit): {git_text(['rev-parse', 'HEAD'], cwd=worktree)}")


if __name__ == "__main__":
    main()
