#!/usr/bin/env python3
"""Publish a prepared release in dependency order, safely resuming partial runs."""

import argparse
import hashlib
import json
import subprocess
import tomllib
import urllib.error
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
DEST = ROOT / "target/release-workspace"


def registry_version(name, version):
    request = urllib.request.Request(
        f"https://crates.io/api/v1/crates/{name}/{version}",
        headers={"User-Agent": "gpui-fast-release (https://github.com/longbridge/gpui-fast)"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)["version"]
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise


def cargo(command, crate, *options):
    subprocess.run([
        "cargo", command, "--manifest-path", str(DEST / crate / "Cargo.toml"),
        "--allow-dirty", *options,
    ], check=True, cwd=ROOT)


def validate(config):
    seen = set()
    versions = set()
    for crate in config["crates"]:
        manifest = tomllib.loads((DEST / crate / "Cargo.toml").read_text(encoding="utf-8"))
        package = manifest["package"]
        versions.add(package["version"])
        assert package["publish"] == ["crates-io"]
        assert package["repository"] == config["repository"]
        assert package["homepage"] == config["homepage"]
        for group in [manifest, *manifest.get("target", {}).values()]:
            for section in ("dependencies", "build-dependencies"):
                for dependency in group.get(section, {}).values():
                    if isinstance(dependency, str):
                        continue
                    assert "git" not in dependency and "workspace" not in dependency
                    assert "version" in dependency
                    if "path" in dependency:
                        assert dependency["package"] in seen, "Release order is not topological"
                        assert dependency["version"] == "=" + package["version"]
        seen.add(package["name"])
        files = subprocess.check_output([
            "cargo", "package", "--manifest-path", str(DEST / crate / "Cargo.toml"),
            "--list", "--allow-dirty",
        ], text=True, cwd=ROOT).splitlines()
        assert "LICENSE" in files and "README.md" in files
        assert not any(file.startswith(("examples/", "benches/", "tests/")) for file in files)
    assert len(versions) == 1
    return versions.pop()


def publish(config, version):
    # Check every existing version before uploading anything. Cargo's archive
    # checksum comparison refuses to silently reuse a different release.
    existing = set()
    for crate in config["crates"]:
        package = tomllib.loads((DEST / crate / "Cargo.toml").read_text(encoding="utf-8"))["package"]
        name = package["name"]
        published = registry_version(name, version)
        if published is None:
            continue
        if published["yanked"]:
            raise RuntimeError(f"{name}@{version} is yanked; choose a new tag")
        cargo("package", crate, "--no-verify")
        archive = DEST / "target/package" / f"{name}-{version}.crate"
        if hashlib.sha256(archive.read_bytes()).hexdigest() != published["checksum"]:
            raise RuntimeError(f"{name}@{version} already exists with different contents; choose a new tag")
        existing.add(crate)
    for crate in config["crates"]:
        if crate in existing:
            print(f"Already published with identical contents: {crate}@{version}", flush=True)
            continue
        # Verification stays enabled: Cargo builds the unpacked archive using
        # registry dependencies. Cargo also waits for index availability.
        cargo("publish", crate, "--registry", "crates-io")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--publish", action="store_true", help="Upload; default only validates packaging")
    args = parser.parse_args()
    config = tomllib.loads((ROOT / "release.toml").read_text(encoding="utf-8"))
    version = validate(config)
    if args.publish:
        publish(config, version)
    else:
        print(f"Validated packaging and dependency order for {len(config['crates'])} crates at {version}")
